{"kind":"critique","id":"20260903T123600774Z-3fa29327:2","run_id":"20260903T123600774Z-3fa29327","timestamp":"2026-09-03T12:36:00.774Z","file_path":"src/services/send-newsletter.ts","spec_path":"src/services/README.md","target_content_hash":"09fdab16","spec_content_hash":"8f04ba4c","reviewer_name":"flash","reviewer_model":"deepseek/deepseek-v4-flash-0731","reviewer_hash":"41d823fa","severity":"error","text":"Invalid input (empty subject) is a failure a caller could plausibly cause, but the service throws `new Error(\"bad subject\")` instead of returning `{ ok: false, error }`. Exceptions must be reserved for programmer error; this must be returned as a domain failure value.","mode":"judgment","axiom_id":"AX-3317a7","axiom_version":1,"assigned_by":"checklist","population":"unknown","authorship":"unknown","authorship_evidence":null,"agent_involved":null,"pre_review":null,"flow":null,"before_run_id":null,"resolved_by":null}
{"kind":"critique","id":"20260903T123600774Z-3fa29327:3","run_id":"20260903T123600774Z-3fa29327","timestamp":"2026-09-03T12:36:00.774Z","file_path":"src/services/send-newsletter.ts","spec_path":"src/services/README.md","target_content_hash":"09fdab16","spec_content_hash":"8f04ba4c","reviewer_name":"flash","reviewer_model":"deepseek/deepseek-v4-flash-0731","reviewer_hash":"41d823fa","severity":"error","text":"The service performs I/O via `console.log(...)` instead of through its injected Store dependency. All external communication and side effects must be mediated by Store methods (e.g. `store.logActivity(...)`), and console output is explicitly disallowed.","mode":"judgment","axiom_id":"AX-6e307b","axiom_version":1,"assigned_by":"checklist","population":"unknown","authorship":"unknown","authorship_evidence":null,"agent_involved":null,"pre_review":null,"flow":null,"before_run_id":null,"resolved_by":null}
