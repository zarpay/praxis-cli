{"kind":"critique","id":"20260903T124144957Z-268f1948:5","run_id":"20260903T124144957Z-268f1948","timestamp":"2026-09-03T12:41:44.957Z","file_path":"src/services/redeem-coupon.ts","spec_path":"src/services/README.md","target_content_hash":"d15ea09e","spec_content_hash":"8f04ba4c","reviewer_name":"v32","reviewer_model":"deepseek/deepseek-v3.2","reviewer_hash":"2b519849","severity":"error","text":"The service hardcodes a specific coupon value 'FREESCOOP' directly in the business logic without isolating it in a configuration or fetching it from the Store, creating silent coupling that could drift between code and data.","mode":"judgment","axiom_id":null,"axiom_version":null,"assigned_by":null,"population":"unknown","authorship":"unknown","authorship_evidence":null,"agent_involved":null,"pre_review":null,"flow":null,"before_run_id":null,"resolved_by":null}
